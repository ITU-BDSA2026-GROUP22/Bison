@page "/"
@model Bison.Razor.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    <h2> Public Timeline </h2>
    
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="observationbox">
            <form method="post" enctype="multipart/form-data">
                <h3>What did you see, @User.Identity.Name?</h3>

                <input type="text"
                    asp-for="ObservationText"
                    placeholder="Write an observation..." />

                <select asp-for="TaxonId">
                    @foreach (var taxon in Model.Taxons)
                    {
                        <option value="@taxon.TaxonId">
                            @taxon.VernacularName
                        </option>
                    }
                </select>

                <input type="file"
                    asp-for="PictureFile"
                    accept="image/jpeg,image/png" />

                <span asp-validation-for="PictureFile"></span>

                <input type="submit" value="Observe" />
            </form>
        </div>
    }

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    @if (obs.PictureId != null)
                    {
                        <img class="thumbnail" src="/picture/@obs.PictureId" alt="Picture from the observation" />
                    }
                    <p>
                        <strong>
                            <a href="/ob/@obs.ID">@obs.Author</a>
                        </strong>
                        @obs.Message
                        <small>&mdash; @obs.Timestamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }

    <div class="pagination">
        @if (Model.CurrentPage > 1)
        {
            <a href="?page=@(Model.CurrentPage - 1)">Previous</a>
        }
        @if (Model.HasNextPage)
        {
            <a href="?page=@(Model.CurrentPage + 1)">Next</a>
        }
    </div>
</div>
